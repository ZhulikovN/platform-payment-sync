[Unit]
Description=Platform Payment Sync - FastAPI webhook service
After=network.target

[Service]
User=deploy
Group=deploy

EnvironmentFile=/home/deploy/platform-payment/current/.env

WorkingDirectory=/home/deploy/platform-payment/current

ExecStart=/home/deploy/platform-payment/current/.venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8000

Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
