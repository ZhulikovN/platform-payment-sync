[Unit]
Description=Очистка старых записей из БД payment_events
After=network.target

[Service]
Type=oneshot
User=deploy
Group=deploy

EnvironmentFile=/home/deploy/platform-payment/current/.env

WorkingDirectory=/home/deploy/platform-payment/current

ExecStart=/home/deploy/platform-payment/current/.venv/bin/python scripts/cleanup_db.py --days 30

StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
